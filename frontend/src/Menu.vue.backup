<template>
    <nav>
        <ul>
            <li><a @click="allMessage">Messages</a></li>
            <li><a @click="createMessage">Create Message</a></li>
            <li><a @click="allPeople">People</a></li>
        </ul>
        <ul>
            <li><a @click="logout">Log out</a></li>
        </ul>
    </nav>
</template>

<style scoped>
li {
    cursor: pointer;
}
</style>

<script setup lang="ts">
import { Routes, router } from "@/router";

function allPeople() {
    if (router.currentRoute.value.path == Routes.readPersonAll) {
        router.go(0);
    } else {
        router.replace(Routes.readPersonAll);
    }
}

function allMessage() {
    if (router.currentRoute.value.path == Routes.readMessageAll) {
        router.go(0);
    } else {
        router.replace(Routes.readMessageAll);
    }
}

function createMessage() {
    router.replace(Routes.createMessage);
}

async function logout() {
    await fetch("/logout", { method: 'GET' });
    window.location.href = "/";
}
</script>


