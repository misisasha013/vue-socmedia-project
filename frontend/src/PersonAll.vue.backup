<script setup lang="ts">
import { onBeforeMount, reactive } from "vue";
import { globals } from "@/stores/globals";
import { Routes, router } from "@/router";

const localState = reactive({
  when: "(loading...)",
  data: [] as { id: number; name: string }[],
});

function click(id: number) {
  router.replace(Routes.readPersonOne + "/" + id);
}

async function fetchAllPeople() {
  let res = await fetch("/people", {
    method: "GET",
    headers: { "Content-type": "application/json; charset=UTF-8" },
  });

  if (!res.ok) {
    globals().showPopup("Error", `The server replied: ${res.status}: ${res.statusText}`);
    return;
  }

  let json = await res.json();

  if (Array.isArray(json)) {
    localState.data = json;
    localState.when = new Date().toString();
    return;
  }

  if (json.status === "ok") {
    localState.data = json.data;
    localState.when = new Date().toString();
  } else {
    globals().showPopup("Error", json.message ?? "Unexpected response");
  }
}

onBeforeMount(fetchAllPeople);
</script>

<template>
  <section>
    <h2>All People</h2>
    <table>
      <thead>
        <tr>
          <th scope="col">Name</th>
        </tr>
      </thead>
      <tbody>
        <tr v-for="elt in localState.data" :key="elt.id" @click="click(elt.id)">
          <td>{{ elt.name }}</td>
        </tr>
      </tbody>
    </table>
    <div>As of {{ localState.when }}</div>
  </section>
</template>

<style scoped>
tr:hover td {
  cursor: pointer;
  background-color: #bbbbcc;
}
</style>

